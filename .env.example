# ── Supabase ──────────────────────────────────────────────────────────────────
# URL du projet Supabase (Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé service_role (Settings > API > service_role) — NE PAS exposer côté client
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret JWT de Supabase — Dashboard → Settings → API → JWT Settings → "JWT Secret"
# Utilisé pour vérifier les tokens émis par Supabase Auth (app Flutter)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── JWT interne (QR codes) ────────────────────────────────────────────────────
# Clé pour signer les QR codes dynamiques (60s) — garder même après migration
SECRET_KEY=change-me-with-a-long-random-string

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Client ID de votre app Google (console.cloud.google.com > Credentials)
# Requis pour activer la connexion Google
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
# Contenu JSON du fichier service account Firebase (sur une seule ligne)
# Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}
